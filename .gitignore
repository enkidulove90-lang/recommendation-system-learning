# ===== Experiment large artifacts (cannot push to GitHub / regenerable) =====
# LightGCNpp saved embeddings (~280MB, regenerated at runtime)
baseline/LightGCNpp/code/embs/

# Large multimodal feature arrays & cached adjacency
# (regenerate via prep_amazon_sports.py / fetch_mm_data.py)
*.npy
*.npz

# MixRAGRec: external reference clone (re-clone from upstream; heavy data excluded)
baseline/MixRAGRec/

# ===== Model weights / checkpoints (regenerable, exceed GitHub 100MB limit) =====
# PRISM E15/E14 experiment checkpoints (~4.6GB of .pt)
baseline/PRISM/outputs/
# PRISM 数据副本中的 .pt 权重（数据集 txt 保留）
baseline/PRISM/data/amazon-baby-mmssl/*.pt
# 通用权重扩展名（实验训练产物，不入库）
*.pt
*.pth
*.ckpt
*.bin

