# ===========================================
# arXiv Recommendation System Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MinerU API Key — 用于 PDF 论文解析（精准解析 v4 API）
# 从 https://mineru.net 的 API 管理页面创建
MINERU_API_KEY=your_mineru_api_key_here

# DeepSeek API Key — 用于论文摘要生成与深度解读
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# arXiv API base URL (default; change only if you use a mirror)
ARXIV_API_BASE=https://export.arxiv.org/api/query

# Request interval in seconds (prevents rate-limiting; arXiv recommends 3+ seconds)
REQUEST_INTERVAL=3.0

# Maximum results per search query
MAX_RESULTS_PER_QUERY=50

# Paper year filter — only crawl papers published in this year or later
START_YEAR=2024

# Output directory for crawled results
OUTPUT_DIR=./output

# Data directory for PDFs, parsed content, summaries, and merged documents
DATA_DIR=./data

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MinerU model version: pipeline (default) | vlm (recommended) | MinerU-HTML
MINERU_MODEL_VERSION=vlm

# MinerU polling config
MINERU_POLL_INTERVAL=3.0
MINERU_POLL_MAX_RETRIES=100

# DeepSeek model
DEEPSEEK_MODEL=deepseek-chat

# ModelScope OpenAI-compatible Qwen multimodal quality gate (optional)
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_VISION_MODEL=Qwen/Qwen3.5-397B-A17B
