{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paper-intake-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "paper-intake.enkiduai.club",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://enkidulove90-lang.github.io,http://127.0.0.1:4322",
    "ARTIFACT_STORAGE_ENABLED": "false",
    "BROWSER_AUTH_ENABLED": "true",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liCbFt3bqH3uEjQA",
    "GITHUB_OWNER_IDS": "289115946",
    "GITHUB_REPOSITORY": "enkidulove90-lang/enkidulove90-lang.github.io",
    "OWNER_IDENTITIES": "enkidulove90@gmail.com,github:289115946",
    "PUBLIC_BASE_URL": "https://paper-intake.enkiduai.club"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paper-intake",
      "database_id": "b8457a94-8974-4b49-b4a0-9238e18a85dc",
      "migrations_dir": "migrations"
    }
  ]
}
