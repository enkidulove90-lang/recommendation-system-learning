{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paper-intake-gateway-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "vars": {
    "ALLOWED_ORIGINS": "https://enkidulove90-lang.github.io,http://127.0.0.1:4322",
    "ARTIFACT_STORAGE_ENABLED": "true",
    "BROWSER_AUTH_ENABLED": "true",
    "GITHUB_REPOSITORY": "enkidulove90-lang/enkidulove90-lang.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paper-intake-test",
      "database_id": "local-paper-intake-test",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "paper-intake-artifacts-test"
    }
  ]
}
