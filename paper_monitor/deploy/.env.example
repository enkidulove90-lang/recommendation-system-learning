# ===== 数据源凭证（设计文档§6 环境变量，通用建议）=====
# OpenAlex 免费 key（polite pool + 更高限额）；可空
OPENALEX_API_KEY=
# 注册 polite pool 的邮箱，强烈建议设置（提升限额、降 429）
OPENALEX_MAILTO=research@example.com
# Semantic Scholar key（匿名易 429）；可空
S2_API_KEY=

# ===== 摄入参数 =====
PM_TIME_WINDOW_DAYS=7
PM_PER_PAGE=100
PM_MAX_PER_SOURCE=200
# 设为 1 时使用内置 fixture 离线运行（测试用）
PM_OFFLINE_FIXTURE=0
# 主题硬过滤开关（1/0）
PM_TOPIC_FILTER=1
# 兴趣画像关键词（逗号分隔，用于重排加分）
PM_INTEREST=recommendation,llm,agent,multimodal,sequential

# ===== 存储 / 投递 =====
PM_DB_PATH=./paper_monitor/data/paper_monitor.db
PM_DELIVERY=console,file
PM_DIGEST_PATH=./paper_monitor/data/digest
PM_LOG_LEVEL=INFO

# ===== Email 投递（可选）=====
PM_SMTP_HOST=
PM_SMTP_PORT=465
PM_SMTP_USER=
PM_SMTP_PASS=
PM_SMTP_TO=

# ===== Slack 投递（可选）=====
PM_SLACK_WEBHOOK=
